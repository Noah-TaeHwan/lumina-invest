# 공시 팩트체커 배포 설정 예시(compose.factcheck.yml). 복사해 .env.factcheck로 쓰고 값을 채운다.
# .env.factcheck는 git이 무시한다. 이 파일에는 실값을 넣지 않는다.
# 판정 API 키 값은 여기에 넣지 않는다 — 키 파일(권한 0600)의 경로만 적는다.
FACTCHECK_DOMAIN=fc.example.com
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=change-me
TYPESAFE_KEY_FILE=/etc/factcheck/typesafe_api_key
FACTCHECK_DATA_HOST_DIR=/srv/factcheck/data
# 하루 상한(입력 토큰 수, 공개 값은 노아가 정한다)
FACTCHECK_DAILY_ANON_RUNS=3
FACTCHECK_DAILY_KEY_TOKENS=2500000
FACTCHECK_DAILY_GLOBAL_TOKENS=3000000
